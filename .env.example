# Copy this file to backend/.env and fill in real values locally.
# Never commit the real .env file.

MODEL_STUDIO_API_KEY=
MODEL_STUDIO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MODEL_STUDIO_MODEL=qwen-plus
MODEL_STUDIO_EMBEDDING_MODEL=text-embedding-v4

# Matches docker-compose.yml defaults — change if you use your own Postgres
DATABASE_URL=postgresql+psycopg://steerium:steerium_dev@localhost:5432/steerium

CORS_ORIGINS=http://localhost:5173
