# Backend environment — copy to backend/.env for local development.
# On Vercel, set the same variables in Project Settings > Environment
# Variables (never commit real secrets).

# Supabase PostgreSQL — transaction pooler URL from Supabase Dashboard >
# Project Settings > Database. The engine detects the pooler and disables
# prepared statements automatically.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Session cookie signing — random 32+ char string in production:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# "development" or "production" — controls secure cookie flags
ENV=development

# Comma-separated origins allowed to call the API cross-origin. Empty for
# same-origin deployments (frontend and API on one Vercel domain).
CORS_ORIGINS=http://localhost:5173

# Alibaba Cloud Model Studio (Qwen AI) — https://bailian.console.aliyun.com
MODEL_STUDIO_API_KEY=
MODEL_STUDIO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MODEL_STUDIO_MODEL=qwen-plus
MODEL_STUDIO_EMBEDDING_MODEL=text-embedding-v4

# Frontend (see frontend/.env.example) — backend base URL. Leave empty for
# same-origin deploys; set only when the API lives on another domain.
VITE_API_URL=
